# ==============================================================================
# 标讯通 (toubiao) 环境变量模板
# 用法：cp .env.example .env 后逐项填写。
# 该文件是本地开发与生产部署的唯一配置来源；docker compose 会自动读取根目录 .env。
# 【必填】标注的变量在 docker compose 启动时缺失会直接报错退出（fail-fast）。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 核心运行配置
# ------------------------------------------------------------------------------
# 【必填】生产环境必须使用 https 域名，会话 Cookie 才会自动带上 Secure 标记。
#         本地开发可填 http://127.0.0.1:3000（注意：此时不要用 https，否则登录会失败）。
APP_URL="https://your-domain.com"
# 浏览器端使用的站点地址（分享链接等）；未设置时回退到 APP_URL。
NEXT_PUBLIC_APP_URL="https://your-domain.com"
# 【必填】会话签名密钥，至少 32 字节随机字符串。生成：openssl rand -hex 32
AUTH_SECRET="replace-with-32-byte-random-secret"
# 强制开启 Secure Cookie（APP_URL 已是 https 时无需设置）
SECURE_COOKIE="false"
# 检索模式：like（SQLite/默认） | fulltext（切换全文引擎后启用）
SEARCH_MODE="like"

# ------------------------------------------------------------------------------
# 2. 数据库
# ------------------------------------------------------------------------------
# 本地开发：直连容器映射到回环的 5432（密码需与 POSTGRES_PASSWORD 一致）。
DATABASE_URL="postgresql://toubiao:toubiao@127.0.0.1:5432/toubiao?schema=public"
# 【必填】docker compose 中 PostgreSQL 容器的密码（与上面 DATABASE_URL 里的密码保持一致）。
POSTGRES_PASSWORD="toubiao"
POSTGRES_USER="toubiao"
POSTGRES_DB="toubiao"

# ------------------------------------------------------------------------------
# 3. 初始管理员（仅 prisma seed 使用；登录后请立即在后台改密）
# ------------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_EMAIL=""
ADMIN_NOTIFICATION_EMAIL=""

# ------------------------------------------------------------------------------
# 4. 公司主体与对公收款信息（用于订单/发票/合同页展示）
# ------------------------------------------------------------------------------
COMPANY_NAME=""
COMPANY_TAX_NUMBER=""
COMPANY_BANK_NAME=""
COMPANY_BANK_ACCOUNT=""
COMPANY_BANK_BRANCH_CODE=""
COMPANY_CONTACT_EMAIL=""
COMPANY_CONTACT_PHONE=""
# 兼容旧字段：前台展示用的对公转账说明文本
BANK_TRANSFER_INFO=""

# ------------------------------------------------------------------------------
# 5. 邮件通知（SMTP）—— 留空时仅打印日志，不真正发信
# ------------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@your-domain.com"

# ------------------------------------------------------------------------------
# 6. 定时任务与告警
# ------------------------------------------------------------------------------
PUSH_CRON="0 8 * * *"
CRAWL_CRON="0 */2 * * *"
CRAWL_POLL_MS=""
CRAWL_ONCE=""
# 企业微信机器人 Webhook，用于系统级告警（留空则不发）
ALERT_WECOM_WEBHOOK=""

# ------------------------------------------------------------------------------
# 7. Jeepay 聚合支付（微信/支付宝/扫码收银台统一路由）
#    文档：https://doc.jeequan.com/#/integrate/open
#    注意：JEEPAY_NOTIFY_URL / JEEPAY_RETURN_URL 必须是公网可访问的 https 地址。
# ------------------------------------------------------------------------------
# 支付网关地址（本地联调默认 http://127.0.0.1:9216，末尾无需斜杠）
JEEPAY_PAY_URL="https://pay.your-domain.com"
# 商户号（MchNo，Jeepay 商户后台获取）
JEEPAY_MCH_NO=""
# 应用 AppId（商户系统应用列表获取）
JEEPAY_APP_ID=""
# 商户 API 密钥（32 位，用于下单签名与回调验签）
JEEPAY_API_KEY=""
# 异步通知回调（公网 https）
JEEPAY_NOTIFY_URL="https://your-domain.com/api/payment/jeepay/notify"
# 支付完成跳转页
JEEPAY_RETURN_URL="https://your-domain.com/pricing"
# 可选：支付方式编码（留空使用默认值）
JEEPAY_WAYCODE_WECHAT="WX_NATIVE"
JEEPAY_WAYCODE_ALIPAY="ALI_QR"
JEEPAY_WAYCODE_CASHIER="QR_CASHIER"

# ------------------------------------------------------------------------------
# 8. 微信支付 API v3（直连商户，可选；与 Jeepay 二选一或并存）
# ------------------------------------------------------------------------------
WECHAT_PAY_APP_ID=""
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_MERCHANT_CERT_SERIAL=""
WECHAT_PAY_MERCHANT_PRIVATE_KEY=""
WECHAT_PAY_PLATFORM_CERT_SERIAL=""
WECHAT_PAY_PLATFORM_PUBLIC_KEY=""
WECHAT_PAY_PLATFORM_CERT=""
WECHAT_PAY_NOTIFY_URL="https://your-domain.com/api/payment/wechat/notify"
# 收款二维码图片地址（可选）
WECHAT_RECEIVE_QR_URL=""

# ------------------------------------------------------------------------------
# 9. 支付宝（可选）
# ------------------------------------------------------------------------------
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_PUBLIC_CERT=""
ALIPAY_NOTIFY_URL="https://your-domain.com/api/payment/alipay/notify"
# 收款二维码图片地址（可选）
ALIPAY_RECEIVE_QR_URL=""

# ------------------------------------------------------------------------------
# 10. 企业微信（应用消息 / 工作台 OAuth / 机器人推送，可选）
# ------------------------------------------------------------------------------
WECOM_CORP_ID=""
WECOM_CORP_SECRET=""
WECOM_AGENT_ID=""
WECOM_REDIRECT_URI="https://your-domain.com/api/wecom/callback"
WECOM_BOT_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# 11. 微信公众号（模板消息推送，可选）
# ------------------------------------------------------------------------------
WECHAT_MP_APPID=""
WECHAT_MP_SECRET=""
WECHAT_MP_TEMPLATE_ID=""
WECHAT_MP_LIFECYCLE_TEMPLATE_ID=""

# ------------------------------------------------------------------------------
# 12. AI 能力（可选；未配置时相关智能功能降级/隐藏）
# ------------------------------------------------------------------------------
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
