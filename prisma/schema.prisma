generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                      @id @default(autoincrement())
  username           String                   @unique
  passwordHash       String
  name               String
  role               String                   @default("USER")
  status             String                   @default("ACTIVE")
  email              String?                  @unique
  emailVerified      Boolean                  @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  subscription       Subscription?
  orders             Order[]
  quotaLedgers       QuotaLedger[]
  verificationTokens EmailVerificationToken[]
  pushWatches        PushWatch[]
  pushRecords        PushRecord[]
  exportAudits       ExportAudit[]
  feedbacks          TenderFeedback[]
  companyProfile     CompanyProfile?
  tenderFollows      TenderFollow[]
  apiKeys            ApiKey[]
  ownedTeam          Team?                    @relation("TeamOwner")
  teamMembership     TeamMember?
  invoices           Invoice[]
  invoiceProfiles    InvoiceProfile[]
  followComments     TenderFollowComment[]
  bidDeposits        BidDeposit[]
  companyCases       CompanyCase[]
  companyQualifications CompanyQualification[]
  bidReviews         BidReview[]
  bidMilestones      BidMilestone[]
  bidAudits          BidAuditRecord[]
  competitorWatches  CompetitorWatch[]
  webhookEndpoints   WebhookEndpoint[]
  proposalProjects   ProposalProject[]
}



model Region {
  code       String  @id
  name       String
  level      Int
  parentCode String?

  @@index([parentCode])
}

model IndustryDict {
  id       Int            @id @default(autoincrement())
  code     String         @unique
  name     String
  parentId Int?
  parent   IndustryDict?  @relation("IndustryHierarchy", fields: [parentId], references: [id])
  children IndustryDict[] @relation("IndustryHierarchy")

  @@index([parentId])
}

model Project {
  id             Int      @id @default(autoincrement())
  projectNo      String?  @unique
  canonicalTitle String
  provinceCode   String?
  firstSeenAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  notices        Tender[]
}

model Tender {
  id               Int          @id @default(autoincrement())
  title            String
  type             String
  provinceCode     String?
  cityCode         String?
  publishDate      DateTime
  expireDate       DateTime?
  purchaser        String?
  agency           String?
  sourceName       String       @default("手动录入")
  sourceUrl        String?      @unique
  content          String
  projectNo        String?
  budgetAmount     Decimal?     @db.Decimal(14, 2)
  awardAmount      Decimal?     @db.Decimal(14, 2)
  openTime         DateTime?
  industryCode     String?
  winningSupplier  String?
  contentHtml      String?
  projectRefId     Int?
  project          Project?     @relation(fields: [projectRefId], references: [id])
  fieldsConfidence Json?
  fieldSources     Json?
  attachments      Attachment[]
  orgContacts      OrgContact[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  pushRecords      PushRecord[]
  feedbacks        TenderFeedback[]
  aiAnalysis       TenderAiAnalysis?
  follows          TenderFollow[]
  bidDeposits      BidDeposit[]
  bidAudits        BidAuditRecord[]
  proposals        ProposalProject[]

  @@index([projectNo])
  @@index([projectRefId])
  @@index([publishDate, type])
  @@index([type, publishDate(sort: Desc)])
  @@index([type])
  @@index([provinceCode, cityCode])
  @@index([purchaser])
  @@index([winningSupplier])
  @@index([industryCode])
}

model Attachment {
  id          Int      @id @default(autoincrement())
  tenderId    Int
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  name        String
  sourceUrl   String
  storageKey  String?
  size        Int?
  contentType String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@index([tenderId])
}

model OrgContact {
  id       Int     @id @default(autoincrement())
  orgName  String
  role     String
  phone    String?
  email    String?
  address  String?
  source   String  @default("extracted")
  tenderId Int?
  tender   Tender? @relation(fields: [tenderId], references: [id], onDelete: SetNull)

  @@index([orgName])
}

model CrawlSource {
  id                  Int             @id @default(autoincrement())
  name                String
  skillCode           String          @unique
  enabled             Boolean         @default(true)
  scheduleCron        String          @default("0 */2 * * *")
  nextRunAt           DateTime?
  requestDelayMs      Int             @default(1200)
  concurrency         Int             @default(1)
  timeoutMs           Int             @default(20000)
  retries             Int             @default(2)
  maxPages            Int             @default(1)
  proxyPolicy         String          @default("off")
  priority            Int             @default(50)
  healthScore         Int?
  consecutiveFailures Int             @default(0)
  configVersion       Int?
  status              String?
  lastMessage         String?
  lastNewCount        Int             @default(0)
  lastRunAt           DateTime?
  lastSuccessAt       DateTime?
  revisions           SkillRevision[]
}

model SkillRevision {
  id         Int         @id @default(autoincrement())
  sourceId   Int
  source     CrawlSource @relation(fields: [sourceId], references: [id])
  skillCode  String
  version    Int
  configYaml String
  config     Json
  changedBy  String      @default("system")
  note       String?
  createdAt  DateTime    @default(now())

  @@unique([skillCode, version])
}

model CrawlLog {
  id           Int      @id @default(autoincrement())
  sourceId     Int
  sourceName   String
  status       String
  trigger      String   @default("manual")
  newCount     Int      @default(0)
  httpOk       Int      @default(0)
  httpFail     Int      @default(0)
  itemsParsed  Int      @default(0)
  avgLatencyMs Int      @default(0)
  durationMs   Int      @default(0)
  message      String?
  startedAt    DateTime
  finishedAt   DateTime

  @@index([sourceId, startedAt])
}

model CrawlTask {
  id          Int       @id @default(autoincrement())
  skillCode   String
  trigger     String    @default("manual")
  status      String    @default("queued")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  nextRetryAt DateTime?
  payload     Json?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  error       String?

  @@index([status, nextRetryAt])
}

model AlertRule {
  id              Int           @id @default(autoincrement())
  scope           String        @default("global")
  condition       String
  threshold       Int
  channel         String
  target          String
  enabled         Boolean       @default(true)
  cooldownMinutes Int           @default(60)
  records         AlertRecord[]

  @@index([enabled, scope])
}

model AlertRecord {
  id      Int       @id @default(autoincrement())
  ruleId  Int
  rule    AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  message String
  firedAt DateTime  @default(now())

  @@index([ruleId, firedAt])
}

model Plan {
  id            Int            @id @default(autoincrement())
  code          String         @unique
  name          String
  priceMonthly  Decimal?       @db.Decimal(10, 2)
  priceYearly   Decimal?       @db.Decimal(10, 2)
  features      Json
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  subscriptions Subscription[]
  orders        Order[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId       Int
  plan         Plan      @relation(fields: [planId], references: [id])
  status       String    @default("ACTIVE")
  billingCycle String    @default("monthly")
  startsAt     DateTime  @default(now())
  endsAt       DateTime?
  autoRenew    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId])
}

model Order {
  id            Int       @id @default(autoincrement())
  orderNo       String    @unique
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        Int
  plan          Plan      @relation(fields: [planId], references: [id])
  billingCycle  String
  amount        Decimal   @db.Decimal(10, 2)
  channel       String    @default("bank")
  status        String    @default("PENDING")
  transactionNo String?     @unique
  prepayCode    String?
  prepayExpiresAt DateTime?
  paidAt        DateTime?
  invoiceStatus String    @default("NONE") // NONE | REQUESTED | ISSUED | REJECTED
  note          String?
  invoice       Invoice?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ExportAudit {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filters      Json
  matchedCount Int
  exportedCount Int
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model PaymentEvent {
  id             Int        @id @default(autoincrement())
  provider       String
  providerEventId String
  eventType      String?
  orderNo        String?
  status         String
  payload        Json
  receivedAt     DateTime   @default(now())
  processedAt    DateTime?
  error          String?

  @@unique([provider, providerEventId])
  @@index([orderNo, receivedAt])
}

model QuotaLedger {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  date      DateTime @db.Date
  used      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, kind, date])
}

model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model PushWatch {
  id           Int          @id @default(autoincrement())
  userId       Int
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  keyword      String
  type         String?
  provinceCode String?
  cityCode     String?
  frequency    String       @default("daily")
  channels     Json         @default("[\"email\"]")
  webhookUrl   String?
  enabled      Boolean      @default(true)
  lastPushAt   DateTime?
  records      PushRecord[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, enabled])
}

model PushRecord {
  id       Int        @id @default(autoincrement())
  userId   Int
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenderId Int
  tender   Tender     @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  watchId  Int?
  watch    PushWatch? @relation(fields: [watchId], references: [id], onDelete: SetNull)
  channel  String     @default("email")
  sentAt   DateTime   @default(now())

  @@unique([userId, tenderId])
  @@index([sentAt])
}

model TenderFeedback {
  id          Int      @id @default(autoincrement())
  tenderId    Int
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  issueType   String
  description String
  contact     String?
  status      String   @default("PENDING")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenderId])
  @@index([status, createdAt])
}

model TenderAiAnalysis {
  id               Int      @id @default(autoincrement())
  tenderId         Int      @unique
  tender           Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  executiveSummary String   @db.Text
  riskRadar        Json
  scoringMethod    Json
  timelineAndKey   Json
  modelUsed        String   @default("builtin-heuristic-v1")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  status           String   @default("COMPLETED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
}

model CompanyProfile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName       String
  registeredCapital String?
  certifications    Json     @default("[]")
  qualifications    Json     @default("[]")
  keyCases          Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyName])
}

model TenderFollow {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenderId     Int
  tender       Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  status       String    @default("EVALUATING") // EVALUATING | DECIDED | DRAFTING | SUBMITTED | WON | LOST
  priority     String    @default("NORMAL")     // LOW | NORMAL | HIGH | URGENT
  assignee     String?
  targetAmount Decimal?  @db.Decimal(14, 2)
  notes        String?   @db.Text
  winRateScore Int?
  remindDate   DateTime?
  teamId       Int?
  team         Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  comments     TenderFollowComment[]
  evaluation   BidProjectEvaluation?
  review       BidReview?
  milestones   BidMilestone[]
  audits       BidAuditRecord[]
  proposals    ProposalProject[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, tenderId])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([teamId, status])
  @@index([teamId, createdAt])
}

model ApiKey {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  keyPrefix    String
  keyHash      String    @unique
  monthlyQuota Int       @default(10000)
  usedCalls    Int       @default(0)
  rateLimitRpm Int       @default(60)
  status       String    @default("ACTIVE") // ACTIVE | REVOKED
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([keyHash])
}

model Team {
  id        Int          @id @default(autoincrement())
  name      String
  ownerId   Int          @unique
  owner     User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  maxSeats  Int          @default(3)
  members   TeamMember[]
  follows   TenderFollow[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId])
}

model TeamMember {
  id       Int      @id @default(autoincrement())
  teamId   Int
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   Int      @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("MEMBER") // OWNER | MANAGER | MEMBER
  title    String?
  joinedAt DateTime @default(now())

  @@index([teamId])
  @@index([userId])
}

model Invoice {
  id               Int       @id @default(autoincrement())
  orderId          Int       @unique
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String    @default("NORMAL") // NORMAL (增值税普通发票) | SPECIAL (增值税专用发票)
  title            String    // 发票抬头
  taxNumber        String    // 纳税人识别号 / 统一社会信用代码
  bankName         String?   // 开户银行
  bankAccount      String?   // 银行账号
  address          String?   // 注册地址
  phone            String?   // 联系电话
  email            String    // 电子发票接收邮箱
  amount           Decimal   @db.Decimal(10, 2) // 价税合计
  taxRate          Decimal   @default(0.06) @db.Decimal(4, 2) // 适用税率 (6%)
  taxAmount        Decimal   @db.Decimal(10, 2) // 税额
  amountWithoutTax Decimal   @db.Decimal(10, 2) // 不含税金额
  itemName         String    @default("*信息技术服务*软件信息技术服务")
  invoiceCode      String?   // 全国发票代码
  invoiceNumber    String?   // 发票号码
  checkCode        String?   // 防伪校验码
  status           String    @default("PENDING") // PENDING (待开具) | ISSUED (已开具) | REJECTED (已驳回)
  rejectReason     String?
  issuedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model InvoiceProfile {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("NORMAL") // NORMAL | SPECIAL
  title       String   // 发票抬头
  taxNumber   String   // 纳税人识别号
  bankName    String?
  bankAccount String?
  address     String?
  phone       String?
  email       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model TenderFollowComment {
  id        Int          @id @default(autoincrement())
  followId  Int
  follow    TenderFollow @relation(fields: [followId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String       @db.Text
  category  String       @default("GENERAL") // GENERAL (普通备忘) | RISK (风险提示) | COMPLIANCE (合规/一票否决) | ASSIGNMENT (任务分派)
  createdAt DateTime     @default(now())

  @@index([followId, createdAt])
  @@index([userId])
}

model BidProjectEvaluation {
  id              Int          @id @default(autoincrement())
  followId        Int          @unique
  follow          TenderFollow @relation(fields: [followId], references: [id], onDelete: Cascade)
  marketScore     Int          @default(80) // 市场与客户关系评分 (0-100)
  techScore       Int          @default(80) // 技术方案与交付可行性 (0-100)
  commercialScore Int          @default(80) // 资质与业绩满足度 (0-100)
  financialScore  Int          @default(80) // 资金占用与回款周期风险 (0-100)
  overallScore    Int          @default(80) // 综合得分 (加权平均)
  decision        String       @default("GO") // GO (坚决投标) | CONDITIONAL_GO (附条件谨慎投标) | NO_GO (建议止损放弃)
  decisionReason  String?      @db.Text // 决策结论与核心理由
  riskNotes       String?      @db.Text // 关键风险警示与应对防范策略
  leadEvaluator   String?      // 牵头评审人/主持会签人
  evaluatedAt     DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([decision])
}

model BidDeposit {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenderId        Int?
  tender          Tender?   @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  projectName     String
  projectNo       String?
  purchaser       String?
  payeeName       String?   // 收款单位/公共资源交易中心/代理机构
  amount          Decimal   @db.Decimal(12, 2) // 保证金缴纳金额(元)
  paymentMethod   String    @default("BANK_TRANSFER") // BANK_TRANSFER (现金电汇) | E_BOND (电子保函) | PAPER_BOND (纸质保函) | CASH_CHECK (支票)
  paidAt          DateTime? // 打款出账时间
  deadline        DateTime? // 截标/开标时间
  refundDeadline  DateTime? // 法定退款截止时间 (开标或合同公示后 5 个工作日)
  refundedAt      DateTime? // 实际退款到账时间
  refundAmount    Decimal?  @db.Decimal(12, 2) // 实际退款金额
  status          String    @default("IN_TRANSIT") // PENDING_PAY | IN_TRANSIT | REFUND_APPLIED | REFUNDED | OVERDUE_RISK | FORFEITED
  bankAccount     String?   // 汇出银行账户信息
  proofFileUrl    String?   // 转账电子回单或保函附件
  notes           String?   @db.Text
  teamId          Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, refundDeadline])
  @@index([tenderId])
}

model CompanyCase {
  id               Int       @id @default(autoincrement())
  userId           Int
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String    // 项目/合同全称
  clientName       String    // 客户/业主单位名称
  amountWan        Decimal   @db.Decimal(10, 2) // 合同金额 (万元)
  signDate         DateTime  // 合同签署日期
  industryCode     String?   // 对应行业赛道
  serviceScope     String?   @db.Text // 供货/服务范围关键词
  projectLeader    String?   // 项目负责人/项目经理
  hasAcceptanceDoc Boolean   @default(false) // 是否具备验收证书/用户好评信
  contractFileUrl  String?   // 合同关键页扫描件存储地址
  teamId           Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, signDate])
  @@index([industryCode])
}

model CompanyQualification {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String    // 证书/资质名称 (如: ISO9001质量管理体系认证、信息安全管理体系认证(ISO27001)、高新技术企业证书、CMMI3级)
  category          String    @default("MANAGEMENT") // MANAGEMENT(管理体系) | CAPABILITY(技术能力) | CREDIT(信用资信) | HONOR(荣誉创新) | SPECIAL(特许资质)
  certNo            String?   // 证书编号
  issuingAuthority  String?   // 颁发机构/发证机关
  issueDate         DateTime? // 初次发证/最新颁证日期
  expiryDate        DateTime  // 有效期截止日期 (核心，用于倒计时与过期废标预警)
  status            String    @default("VALID") // VALID(正常有效) | EXPIRING_90(90天内换证) | EXPIRING_30(30天高危临期) | EXPIRED(已逾期废标)
  annualInspectDate DateTime? // 下次年审/监督审核截止日期
  coverageScope     String?   @db.Text // 认证范围 (业务/产品/服务范围)
  level             String?   // 等级/级别 (如: 壹级 / 甲级 / 3级 / AAA)
  certFileUrl       String?   // 扫描件/电子证照存储地址
  notes             String?   @db.Text
  teamId            Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, expiryDate])
  @@index([category, status])
}

model BidReview {
  id              Int          @id @default(autoincrement())
  followId        Int          @unique
  follow          TenderFollow @relation(fields: [followId], references: [id], onDelete: Cascade)
  userId          Int
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome         String       // WON(中标) | LOST(失标)
  winningSupplier String?      // 最终中标单位名称
  winningAmount   Decimal?     @db.Decimal(14, 2) // 最终中标金额(元)
  myBidAmount     Decimal?     @db.Decimal(14, 2) // 我方最终投标报价(元)
  priceGapPercent Decimal?     @db.Decimal(6, 2)  // 价格偏差率百分比 ((我方-中标)/中标*100)
  ranking         Int?         // 综合排名 (如 1, 2, 3...)
  scoreGap        Decimal?     @db.Decimal(5, 2)  // 与第一名的综合分差
  primaryCause    String       // 核心失标/中标归因: PRICE(价格偏离) | TECHNICAL(技术方案) | COMMERCIAL(资质业绩) | CLIENT_RELATION(客情控标) | COMPLIANCE(废标违约) | DELIVERY(交付服务) | OTHER(其他)
  secondaryCauses Json?        @default("[]") // 次要归因标签数组
  strengths       String?      @db.Text // 本次亮点与经验沉淀
  shortcomings    String?      @db.Text // 短板与失误教训
  actionItems     String?      @db.Text // 整改防范措施与沉淀
  reviewer        String?      // 复盘主持人/主笔人
  teamId          Int?
  reviewedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, outcome])
  @@index([primaryCause])
  @@index([reviewedAt])
  @@index([teamId])
}

model BidMilestone {
  id          Int           @id @default(autoincrement())
  followId    Int?
  follow      TenderFollow? @relation(fields: [followId], references: [id], onDelete: Cascade)
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String        // 里程碑/节点名称 (如: 技术方案初稿交付、现场踏勘答疑、内部封标评审、保证金到账核实)
  type        String        @default("OTHER") // SUBMISSION(递交开标) | CLARIFICATION(答疑澄清) | SITE_VISIT(踏勘答疑) | DEPOSIT_PAY(缴纳保证金) | INTERNAL_REVIEW(内部评审) | OTHER(其他)
  targetDate  DateTime      // 发生/截止时间
  status      String        @default("PENDING") // PENDING(待完成) | COMPLETED(已完成) | CANCELLED(已取消)
  assignee    String?       // 责任人
  notes       String?       @db.Text // 备忘说明或关键要求
  teamId      Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, targetDate])
  @@index([followId])
  @@index([teamId, targetDate])
}

model BidAuditRecord {
  id                 Int           @id @default(autoincrement())
  followId           Int?
  follow             TenderFollow? @relation(fields: [followId], references: [id], onDelete: SetNull)
  userId             Int
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenderId           Int?
  tender             Tender?       @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  documentTitle      String        // 投标文件名称/送检标段名称
  auditScore         Int           @default(100) // 清标健康分 (0-100)
  riskLevel          String        @default("LOW") // LOW(低风险通过) | MEDIUM(中度瑕疵警示) | HIGH(高危废标隐患)
  fatalIssuesCount   Int           @default(0) // 一票否决/法定废标项数
  warningIssuesCount Int           @default(0) // 扣分与瑕疵项数量
  issuesDetails      Json          // 检测出的隐患清单明细
  auditedContent     String?       @db.Text // 送检文本摘录/要点
  inspector          String?       // 清标复核人
  teamId             Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId, riskLevel])
  @@index([followId])
  @@index([tenderId])
  @@index([teamId])
}

model CompetitorWatch {
  id                  Int      @id @default(autoincrement())
  userId              Int
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitorName      String   // 目标竞对企业名称全称
  tag                 String   @default("CORE") // CORE(核心宿敌) | REGIONAL(区域龙头) | LOW_PRICE(价格搅局者) | PARTNER(潜在联合体)
  notes               String?  // 内部攻防战术备忘/特征记录
  alertOnWin          Boolean  @default(true) // 竞对中标实时情报提醒
  alertOnEncroachment Boolean  @default(true) // 渗透我方深耕客户/战区红色预警
  teamId              Int?     // 团队多席位共享归属
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, competitorName])
  @@index([userId])
  @@index([competitorName])
  @@index([teamId])
}

model WebhookEndpoint {
  id           Int                  @id @default(autoincrement())
  userId       Int
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String               // 终端名称/业务机器人群名 (如: 销售一部企微机器人)
  channel      String               // WECOM(企微) | DINGTALK(钉钉) | FEISHU(飞书) | GENERIC(通用HTTP)
  webhookUrl   String               // 完整的 Webhook URL
  secret       String?              // 加签密钥 (钉钉加签密钥 / 飞书签名Secret)
  events       Json                 // 订阅的业务事件类型列表，如 ["DEADLINE", "COMPETITOR", "DEPOSIT", "AUDIT", "TENDER"]
  enabled      Boolean              @default(true)
  teamId       Int?                 // 团队多席位共享归属
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  logs         WebhookDeliveryLog[]

  @@index([userId, enabled])
  @@index([teamId])
}

model WebhookDeliveryLog {
  id             Int             @id @default(autoincrement())
  endpointId     Int
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventType      String          // DEADLINE | COMPETITOR | DEPOSIT | AUDIT | TENDER | TEST
  payloadSummary String          // 投递主题/卡片标题摘要
  statusCode     Int             // HTTP 状态码 (200, 400, 500 等)
  latencyMs      Int             // 投递网络往返耗时 (毫秒)
  success        Boolean         // 是否投递成功
  error          String?         // 异常或错误信息
  createdAt      DateTime        @default(now())

  @@index([endpointId, createdAt])
  @@index([eventType])
}

model ProposalProject {
  id               Int           @id @default(autoincrement())
  userId           Int
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenderId         Int?
  tender           Tender?       @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  followId         Int?
  follow           TenderFollow? @relation(fields: [followId], references: [id], onDelete: SetNull)
  title            String        // 标书装配工程名称
  status           String        @default("DRAFT") // DRAFT(装配中) | COMPLETED(装配就绪) | AUDITED(已通过质检)
  targetPurchaser  String?       // 目标发包采购单位
  bidAmountWan     Float?        // 拟投标报价金额 (万元)
  projectDuration  String?       // 承诺实施交付工期
  assembledVolumes Json          // 存储装配好的六大卷宗内容结构
  teamId           Int?          // 团队席位共享归属
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, status])
  @@index([tenderId])
  @@index([followId])
  @@index([teamId])
}
